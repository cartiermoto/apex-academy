# Password that unlocks the site. Required.
SITE_PASSWORD=change-me

# Secret used to sign the session cookie. Optional — falls back to SITE_PASSWORD.
# Set a long random value in production so changing the password does not have
# to invalidate anything else.
AUTH_SECRET=

# Neon Postgres connection string (Vercel Marketplace → Neon → Connect Project
# injects this automatically). Optional locally: without it, progress is stored
# in .data/apex-progress.json.
DATABASE_URL=
